#!/bin/sh
# Run shared VM tools from OpenCode Desktop without installing a second stack.
# VM, user and home are detected from standard OrbStack home paths.
set -eu

tool=${1:?Usage: ai-tooling-vm serena|context7|engram|rtk|ccusage [args...]}
shift
case "$tool" in
    serena|context7|engram|rtk|ccusage) ;;
    *) printf 'Unsupported tool: %s\n' "$tool" >&2; exit 2 ;;
esac

config_file=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/ai-tooling-vm.conf
if [ -f "$config_file" ]; then
    # shellcheck source=/dev/null
    . "$config_file"
fi

orb_bin=${ORB_BIN:-/usr/local/bin/orb}
orbstack_root="$HOME/OrbStack"

case "$PWD" in
    "$orbstack_root"/*/*)
        relative=${PWD#"$orbstack_root"/}
        vm_name=${relative%%/*}
        vm_relative=${relative#*/}
        case "$vm_relative" in
            home/*)
                user_and_project=${vm_relative#home/}
                vm_user=${user_and_project%%/*}
                vm_home=/home/$vm_user
                ;;
            root|root/*)
                vm_user=root
                vm_home=/root
                ;;
            *)
                vm_user=${AI_TOOLING_VM_USER:?Set AI_TOOLING_VM_USER for projects outside Linux home directories}
                vm_home=${AI_TOOLING_VM_HOME:?Set AI_TOOLING_VM_HOME for projects outside Linux home directories}
                ;;
        esac
        vm_directory=/$vm_relative
        in_volume=1
        ;;
    *)
        # Outside OrbStack volumes: MCP servers use the configured addons home.
        vm_name=${AI_TOOLING_VM_NAME:?Set AI_TOOLING_VM_NAME in ai-tooling-vm.conf}
        vm_user=${AI_TOOLING_VM_USER:?Set AI_TOOLING_VM_USER in ai-tooling-vm.conf}
        vm_home=${AI_TOOLING_VM_HOME:?Set AI_TOOLING_VM_HOME in ai-tooling-vm.conf}
        vm_directory=$vm_home
        in_volume=0
        ;;
esac

if [ "$tool" = rtk ] && [ "$in_volume" -eq 0 ]; then
    printf 'RTK requires a project inside an OrbStack volume.\n' >&2
    exit 2
fi

case "$tool" in
    serena)
        exec "$orb_bin" -m "$vm_name" -u "$vm_user" -w "$vm_directory" \
            "$vm_home/.local/bin/serena" start-mcp-server \
            --project-from-cwd --context=ide --open-web-dashboard false "$@"
        ;;
    context7)
        # The login shell supplies Node/npx's VM PATH.
        exec "$orb_bin" -m "$vm_name" -u "$vm_user" -w "$vm_directory" \
            bash -lc 'bin="$HOME/.local/bin/context7-mcp"; [ -x "$bin" ] || bin="$HOME/.local/bin/ai-context7-mcp"; exec "$bin" "$@"' ai-context7-mcp "$@"
        ;;
    engram|rtk|ccusage)
        exec "$orb_bin" -m "$vm_name" -u "$vm_user" -w "$vm_directory" \
            "$vm_home/.local/bin/$tool" "$@"
        ;;
esac
